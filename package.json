{
  "name": "context-layer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:down": "docker compose down",
    "db:info": "tsx scripts/flyway.ts info",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "tsx scripts/flyway.ts migrate",
    "db:railway:migrate": "tsx scripts/flyway.ts migrate --railway",
    "db:up": "docker compose up -d --wait postgres",
    "db:validate": "tsx scripts/flyway.ts validate",
    "dev:api": "dotenv -e .env -- pnpm --filter @context-layer/api dev",
    "dev:mcp": "dotenv -e .env -- pnpm --filter @context-layer/mcp dev",
    "digest:preview": "dotenv -e .env -- tsx apps/api/scripts/digest-preview.ts",
    "dev:full": "pnpm db:up && concurrently --kill-others-on-fail --names api,mcp,web --prefix-colors magenta,yellow,cyan \"pnpm dev:api\" \"pnpm dev:mcp\" \"pnpm dev:web\"",
    "dev:web": "dotenv -e .env -- pnpm --filter @context-layer/web dev",
    "docker:build": "docker build -f packages/db/Dockerfile.flyway -t context-layer-flyway . && docker build -f apps/slm/Dockerfile -t context-layer-slm . && docker build -f apps/api/Dockerfile -t context-layer-api . && docker build -f apps/mcp/Dockerfile -t context-layer-mcp . && docker build -f apps/web/Dockerfile -t context-layer-web . && docker build -f apps/digest-cron/Dockerfile -t context-layer-digest-cron .",
    "email:dev": "pnpm --filter @context-layer/email dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke:bundles": "node scripts/smoke-server-bundles.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:bundles",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "concurrently": "10.0.4",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
