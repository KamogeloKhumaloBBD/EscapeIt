{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/db/Dockerfile.flyway",
    "watchPatterns": [
      "/packages/db/migrations/**",
      "/packages/db/Dockerfile.flyway",
      "/railway.flyway.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "NEVER"
  }
}
