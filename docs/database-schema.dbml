Project context_layer {
  database_type: "PostgreSQL"
  Note: '''
    Context Layer schema through Flyway V7.

    Flyway SQL under packages/db/migrations is authoritative. Migrations run
    explicitly and never during API or web startup. Product IDs are UUIDv7
    strings generated by application code. Better Auth owns users, sessions,
    accounts, verifications, and OAuth provider grants.
  '''
}

Enum workspace_role {
  owner
  member
}

Enum connection_status {
  disconnected
  connected
  error
}

Enum activity_category {
  workspace
  integration
  mcp
  context
  webhook
  notification
}

Enum activity_status {
  started
  succeeded
  partially_succeeded
  failed
}

Table users {
  id text [pk]
  name text [not null]
  email text [not null, unique]
  emailVerified boolean [not null, default: false]
  image text
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  Note: "Better Auth identity. Authentication does not create a workspace."
}

Table sessions {
  id text [pk]
  userId text [not null]
  token text [not null, unique]
  expiresAt timestamptz [not null]
  ipAddress text
  userAgent text
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  Note: "Persistent Better Auth sessions. Session material must never be logged."
}

Table accounts {
  id text [pk]
  userId text [not null]
  accountId text [not null]
  providerId text [not null]
  accessToken text
  refreshToken text
  accessTokenExpiresAt timestamptz
  refreshTokenExpiresAt timestamptz
  scope text
  idToken text
  password text
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  Note: "Better Auth accounts. Separate from product integration_accounts. Password authentication is disabled."
}

Table verifications {
  id text [pk]
  identifier text [not null]
  value text [not null]
  expiresAt timestamptz [not null]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  Note: "Better Auth verification records. Email OTP values are configured to be stored as hashes."
}

Table oauthClient {
  id text [pk]
  clientId text [not null, unique]
  clientSecret text
  disabled boolean [not null, default: false]
  skipConsent boolean
  enableEndSession boolean
  subjectType text
  scopes text
  userId text
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]
  expiresAt timestamptz
  name text
  uri text
  icon text
  contacts text
  tos text
  policy text
  softwareId text
  softwareVersion text
  softwareStatement text
  redirectUris text [not null]
  postLogoutRedirectUris text
  tokenEndpointAuthMethod text
  grantTypes text
  responseTypes text
  public boolean
  type text
  requirePKCE boolean
  referenceId text
  metadata jsonb

  Note: "Better Auth OAuth 2.1 clients. Dynamically registered MCP clients are public and require PKCE."
}

Table oauthConsent {
  id text [pk]
  clientId text [not null]
  userId text
  referenceId text
  scopes text [not null]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (clientId, userId, referenceId) [unique, name: "oauthConsent_member_client_workspace_unique"]
  }

  Note: "Personal MCP consent. referenceId binds the grant to the approved workspace."
}

Table oauthRefreshToken {
  id text [pk]
  token text [not null, unique]
  clientId text [not null]
  sessionId text
  userId text [not null]
  referenceId text
  expiresAt timestamptz [not null]
  createdAt timestamptz [not null, default: `now()`]
  revoked timestamptz
  authTime timestamptz
  scopes text [not null]

  Note: "Hashed opaque rolling refresh credentials. Active clients rotate within a one-year lifetime."
}

Table oauthAccessToken {
  id text [pk]
  token text [not null, unique]
  clientId text [not null]
  sessionId text
  userId text
  referenceId text
  refreshId text
  expiresAt timestamptz [not null]
  createdAt timestamptz [not null, default: `now()`]
  scopes text [not null]

  Note: "Hashed opaque one-hour MCP access credentials."
}

Table workspaces {
  id text [pk]
  name text [not null]
  createdByUserId text
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  Note: "Tenant root. Name is trimmed to 1-120 characters; updatedAt must not precede createdAt."
}

Table workspace_memberships {
  id text [pk]
  workspaceId text [not null]
  userId text [not null, unique]
  role workspace_role [not null]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (workspaceId, id) [unique, name: "workspace_memberships_workspace_id_id_unique"]
    workspaceId [name: "workspace_memberships_workspace_id_idx"]
  }

  Note: '''
    A user may belong to at most one workspace. SQL also has a partial unique
    index on workspaceId where role = owner, permitting at most one owner per
    workspace. Workspace creation creates its owner membership atomically.
  '''
}

Table workspace_invitations {
  id text [pk]
  workspaceId text [not null]
  normalizedEmail text [not null]
  tokenHash bytea [not null, unique]
  invitedByMembershipId text [not null]
  acceptedByMembershipId text
  expiresAt timestamptz [not null]
  acceptedAt timestamptz
  revokedAt timestamptz
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (normalizedEmail, expiresAt) [name: "workspace_invitations_pending_email_idx"]
  }

  Note: '''
    tokenHash is a 32-byte SHA-256 digest; raw invitation tokens are never
    persisted. Email is trimmed lowercase. Acceptance and revocation are
    mutually exclusive. SQL has a partial unique index allowing one pending
    invitation per workspace/email. Invitations expire after seven days.
  '''
}

Table integrations {
  id text [pk]
  workspaceId text [not null]
  provider text [not null]
  status connection_status [not null, default: 'disconnected']
  configuration jsonb [not null, default: `'{}'::jsonb`]
  configuredByMembershipId text
  lastValidatedAt timestamptz
  lastErrorCode text
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (workspaceId, provider) [unique, name: "integrations_workspace_provider_unique"]
    (workspaceId, id) [unique, name: "integrations_workspace_id_id_unique"]
    (workspaceId, status) [name: "integrations_workspace_status_idx"]
  }

  Note: '''
    One workspace installation per provider. Provider is an extensible
    lowercase kebab-case key. configuration must be a non-secret JSON object.
    Error codes are sanitized and limited to 100 characters.
  '''
}

Table integration_accounts {
  id text [pk]
  workspaceId text [not null]
  integrationId text [not null]
  membershipId text [not null]
  status connection_status [not null, default: 'disconnected']
  credentialEnvelope text
  lastValidatedAt timestamptz
  lastErrorCode text
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (integrationId, membershipId) [unique, name: "integration_accounts_workspace_member_unique"]
    (workspaceId, id) [unique, name: "integration_accounts_workspace_id_id_unique"]
    (membershipId, status) [name: "integration_accounts_membership_status_idx"]
  }

  Note: '''
    One provider account per member and installation. OAuth credentials exist
    only in a versioned AES-256-GCM envelope bound to this record ID and the
    integration-account purpose. Connected/error records require credentials;
    disconnected records must have no envelope. Provider calls use the acting
    member's account. No external identity is persisted on this record.
  '''
}

Table integration_scopes {
  id text [pk]
  workspaceId text [not null]
  integrationId text [not null]
  scopeKey text [not null]
  externalId text [not null]
  displayName text [not null]
  createdByMembershipId text [not null]
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (integrationId, scopeKey, externalId) [unique, name: "integration_scopes_provider_identity_unique"]
    (workspaceId, integrationId) [name: "integration_scopes_workspace_integration_idx"]
  }

  Note: '''
    Workspace-wide deny-by-default resource allowlist. scopeKey is a namespaced
    lowercase key such as jira.project and must match the integration provider.
    No rows means no provider-resource access.
  '''
}

Table integration_mcp_tools {
  id text [pk]
  workspaceId text [not null]
  integrationId text [not null]
  toolName text [not null]
  enabledByMembershipId text [not null]
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (integrationId, toolName) [unique, name: "integration_mcp_tools_integration_name_unique"]
    (workspaceId, id) [unique, name: "integration_mcp_tools_workspace_id_id_unique"]
    (workspaceId, integrationId) [name: "integration_mcp_tools_workspace_integration_idx"]
  }

  Note: '''
    Workspace-wide deny-by-default MCP tool allowlist. toolName is a
    provider-prefixed key such as jira_get_issue, 3-128 characters, matching
    ^[a-z][a-z0-9]*(_[a-z0-9]+)+$. No rows for an integration means no tools.
  '''
}

Table integration_bundles {
  id text [pk]
  workspaceId text [not null]
  name text [not null]
  description text
  createdByMembershipId text [not null]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (workspaceId, id) [unique, name: "integration_bundles_workspace_id_id_unique"]
    workspaceId [name: "integration_bundles_workspace_idx"]
  }

  Note: '''
    Workspace-defined named group of the workspace's provider installations,
    used only to scope which providers' MCP tools a personal access token can
    see. name is 1-120 characters; description, when present, is 1-500.
  '''
}

Table integration_bundle_providers {
  id text [pk]
  workspaceId text [not null]
  bundleId text [not null]
  integrationId text [not null]
  addedByMembershipId text [not null]
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (bundleId, integrationId) [unique, name: "integration_bundle_providers_unique"]
    (workspaceId, id) [unique, name: "integration_bundle_providers_workspace_id_id_unique"]
    (workspaceId, bundleId) [name: "integration_bundle_providers_workspace_bundle_idx"]
  }

  Note: '''
    Membership of one workspace integration in one bundle. References the
    workspace installation (integrationId), not a raw provider key, so bundle
    membership survives disconnect/reconnect cycles. An empty bundle is valid
    and yields no tools for tokens scoped to it.
  '''
}

Table mcp_tokens {
  id text [pk]
  workspaceId text [not null]
  createdByMembershipId text [not null]
  name text [not null]
  prefix text [not null]
  tokenHash bytea [not null, unique]
  bundleId text
  expiresAt timestamptz
  lastUsedAt timestamptz
  revokedAt timestamptz
  revokedByMembershipId text
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (workspaceId, createdAt, id) [name: "mcp_tokens_workspace_created_idx"]
  }

  Note: '''
    Personal MCP credentials. tokenHash is the unique 32-byte SHA-256 digest;
    the raw ctx_mcp token is shown once and never persisted. prefix is safe UI
    metadata. createdByMembershipId determines the principal and provider
    accounts used by every MCP request. bundleId, when set, restricts the
    token's MCP tools to that bundle's providers; null means every connected
    provider, matching prior behavior. Tokens currently do not expire.
    Deleting a bundle referenced by a non-revoked token is rejected.
  '''
}

Table notification_channels {
  id text [pk]
  workspaceId text [not null]
  provider text [not null]
  status connection_status [not null, default: 'disconnected']
  name text [not null]
  configuration jsonb [not null, default: `'{}'::jsonb`]
  credentialEnvelope text
  createdByMembershipId text [not null]
  lastValidatedAt timestamptz
  lastErrorCode text
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (workspaceId, id) [unique, name: "notification_channels_workspace_id_id_unique"]
    (workspaceId, status) [name: "notification_channels_workspace_status_idx"]
  }

  Note: '''
    Provider-neutral workspace delivery channel. Secrets and webhook URLs exist
    only in an AES-256-GCM envelope bound to this record ID and the
    notification-channel purpose. configuration contains non-secret JSON only.
  '''
}

Table notification_preferences {
  id text [pk]
  workspaceId text [not null]
  membershipId text [not null]
  eventKey text [not null]
  enabled boolean [not null, default: true]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (membershipId, eventKey) [unique, name: "notification_preferences_membership_event_unique"]
    (workspaceId, membershipId) [name: "notification_preferences_workspace_member_idx"]
  }

  Note: '''
    Sparse member overrides. eventKey is a namespaced key such as
    jira.issue.updated. Missing rows resolve to the provider registry's default:
    effectiveEnabled = storedOverride?.enabled ?? registryDefaultEnabled.
  '''
}

Table activity_events {
  id text [pk]
  workspaceId text [not null]
  actorMembershipId text
  subjectMembershipId text
  parentEventId text
  correlationId text [not null]
  category activity_category [not null]
  status activity_status [not null]
  provider text
  operation text [not null]
  summary text [not null]
  metadata jsonb [not null, default: `'{}'::jsonb`]
  externalEventId text
  occurredAt timestamptz [not null, default: `now()`]
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (workspaceId, id) [unique, name: "activity_events_workspace_id_id_unique"]
    (workspaceId, correlationId, occurredAt, id) [name: "activity_events_correlation_idx"]
    (workspaceId, occurredAt, id) [name: "activity_events_cursor_idx"]
  }

  Note: '''
    Immutable tenant activity and correlation history. metadata is sanitized,
    non-secret JSON. SQL has a partial unique index on
    (workspaceId, provider, externalEventId) when externalEventId is present,
    providing webhook deduplication. Cursor order is occurredAt DESC, id DESC.
  '''
}

Ref: sessions.userId > users.id [delete: cascade]
Ref: accounts.userId > users.id [delete: cascade]
Ref: oauthClient.userId > users.id [delete: cascade]
Ref: oauthConsent.clientId > oauthClient.clientId [delete: cascade]
Ref: oauthConsent.userId > users.id [delete: cascade]
Ref: oauthRefreshToken.clientId > oauthClient.clientId [delete: cascade]
Ref: oauthRefreshToken.sessionId > sessions.id [delete: set null]
Ref: oauthRefreshToken.userId > users.id [delete: cascade]
Ref: oauthAccessToken.clientId > oauthClient.clientId [delete: cascade]
Ref: oauthAccessToken.sessionId > sessions.id [delete: set null]
Ref: oauthAccessToken.userId > users.id [delete: cascade]
Ref: oauthAccessToken.refreshId > oauthRefreshToken.id [delete: cascade]
Ref: workspaces.createdByUserId > users.id [delete: set null]
Ref: workspace_memberships.workspaceId > workspaces.id [delete: cascade]
Ref: workspace_memberships.userId > users.id [delete: restrict]

Ref: workspace_invitations.workspaceId > workspaces.id [delete: cascade]
Ref: workspace_invitations.(workspaceId, invitedByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]
Ref: workspace_invitations.(workspaceId, acceptedByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]

Ref: integrations.workspaceId > workspaces.id [delete: cascade]
Ref: integrations.(workspaceId, configuredByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]

Ref: integration_accounts.(workspaceId, integrationId) > integrations.(workspaceId, id) [delete: cascade]
Ref: integration_accounts.(workspaceId, membershipId) > workspace_memberships.(workspaceId, id) [delete: cascade]

Ref: integration_scopes.(workspaceId, integrationId) > integrations.(workspaceId, id) [delete: cascade]
Ref: integration_scopes.(workspaceId, createdByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]

Ref: integration_mcp_tools.(workspaceId, integrationId) > integrations.(workspaceId, id) [delete: cascade]
Ref: integration_mcp_tools.(workspaceId, enabledByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]

Ref: integration_bundles.workspaceId > workspaces.id [delete: cascade]
Ref: integration_bundles.(workspaceId, createdByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]

Ref: integration_bundle_providers.(workspaceId, bundleId) > integration_bundles.(workspaceId, id) [delete: cascade]
Ref: integration_bundle_providers.(workspaceId, integrationId) > integrations.(workspaceId, id) [delete: cascade]
Ref: integration_bundle_providers.(workspaceId, addedByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]

Ref: mcp_tokens.workspaceId > workspaces.id [delete: cascade]
Ref: mcp_tokens.(workspaceId, createdByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]
Ref: mcp_tokens.(workspaceId, revokedByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]
Ref: mcp_tokens.(workspaceId, bundleId) > integration_bundles.(workspaceId, id) [delete: no action]

Ref: notification_channels.workspaceId > workspaces.id [delete: cascade]
Ref: notification_channels.(workspaceId, createdByMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]

Ref: notification_preferences.(workspaceId, membershipId) > workspace_memberships.(workspaceId, id) [delete: cascade]

Ref: activity_events.workspaceId > workspaces.id [delete: cascade]
Ref: activity_events.(workspaceId, actorMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]
Ref: activity_events.(workspaceId, subjectMembershipId) > workspace_memberships.(workspaceId, id) [delete: no action]
Ref: activity_events.(workspaceId, parentEventId) > activity_events.(workspaceId, id) [delete: no action]
