# Local PostgreSQL
# Flyway local commands use these same PostgreSQL settings through Docker Compose.
POSTGRES_USER=context_layer
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://context_layer:replace-with-a-local-password@localhost:5432/context_layer
DATABASE_SSL_MODE=disable

# API
API_PORT=4000
BETTER_AUTH_SECRET=replace-with-32-random-character
BETTER_AUTH_URL=http://localhost:3000
# Resend's test sender only delivers to your Resend account email.
# Verify a domain before sending invitations to other addresses.
AUTH_EMAIL_FROM="Context Layer <auth@your-verified-domain.com>"
RESEND_API_KEY=re_replace-with-resend-api-key

# Optional Atlassian integrations. Configure both values or leave both unset.
# Callbacks:
# http://localhost:3000/api/integrations/jira/oauth/callback
# http://localhost:3000/api/integrations/confluence/oauth/callback
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=

# Optional Bitbucket integration. Configure both values or leave both unset.
# The OAuth consumer's checked scopes must be set to read-only (account,
# repository) in Bitbucket workspace settings — Bitbucket fixes scopes at
# consumer-registration time and does not support requesting a subset per
# authorization the way the Atlassian OAuth apps above do. Context Layer only
# exposes read-only Bitbucket MCP tools regardless of what the consumer grants,
# and any excess granted scope is still visible in the integration detail page
# and activity log.
# Callback:
# http://localhost:3000/api/integrations/bitbucket/oauth/callback
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=
# Enable expiring user tokens and OAuth during installation in the GitHub App.
# Callback: http://localhost:3000/api/integrations/github/oauth/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# A GitHub App has one webhook shared by every installation, so its URL is set
# on the App itself rather than per integration, and the signature is the only
# proof of origin. Set the App's Webhook URL to <public url>/api/webhooks/github
# and put its secret here; without it GitHub notifications stay off while the
# rest of the integration keeps working. Because the URL lives on the App, each
# environment needs its own App.
GITHUB_APP_WEBHOOK_SECRET=
# Confluence Cloud has no way for an OAuth app to register a webhook, so its
# events arrive through a Forge app instead (see forge/confluence-events).
# This is that app's id, printed by `forge register`. Forge signs every
# delivery with a token whose audience is this id; without it Confluence
# notifications stay off and the rest of the integration keeps working.
FORGE_APP_ID=
# The share link for that Forge app, from the developer console under
# Distribution. Shown to workspace owners as "Approve in Confluence"; leave it
# blank and the prompt stays hidden.
FORGE_APP_INSTALL_URL=

# Daily digest. Both are optional and independent.
#
# The bearer token the scheduler presents to POST /api/digests/run. Leave it
# blank and that route is never mounted, so nothing can trigger a scheduled run;
# an owner's "send now" keeps working either way. Minimum 32 characters.
DIGEST_RUN_SECRET=
# The UTC hour the schedule fires, which also defines the 24 hours each digest
# covers. Keep it equal to the hour in the scheduler's cron expression, or
# digests will overlap or leave gaps. 16 is 18:00 South African time, and the
# matching cron is "0 16 * * *".
DIGEST_SEND_HOUR_UTC=16
# A llama.cpp server that writes the digest prose (see apps/slm). On Railway
# this is the private address of the SLM service, which must have no public
# domain. Locally:
#   docker run -d -p 8085:8080 -v /path/to/models:/models:ro \
#     ghcr.io/ggml-org/llama.cpp:server -m /models/gemma-3-4b-it-Q4_K_M.gguf \
#     -c 8192 -t 4 --host 0.0.0.0 --port 8080
# Leave it blank and digests still send, rendered from the events themselves.
SLM_BASE_URL=
# Optional locally. Production uses the private SLM service's API key so a
# compromised sibling service cannot invoke model inference anonymously.
SLM_API_KEY=

CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PUBLIC_APP_URL=http://localhost:3000

# Frontend server-side proxy target. Never expose this as NEXT_PUBLIC_*.
API_INTERNAL_URL=http://localhost:4000
